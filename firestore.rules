rules_version = '2';

// Regras do banco `duel-start` (ver firebase.json). O app só escreve o que é
// do próprio usuário e que não vale estrelas: perfil (nick, foto, cidade,
// notificações) e a reserva do nick. As carteiras (estrelas, vitórias e
// derrotas por categoria) nascem com valores fixos no cadastro e depois só
// mudam via Cloud Functions (que ignoram estas regras) - um app modificado
// nunca consegue mexer no saldo.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isNick(n) {
      return n is string && n.matches('^[a-z0-9_]{3,20}$');
    }

    function nickDoc(n) {
      return /databases/$(database)/documents/nicks/$(n);
    }

    // Campos que o próprio usuário pode alterar depois do cadastro.
    function editableFields() {
      return ['nick', 'nickLower', 'nickChangedAt', 'photoUrl', 'cityId', 'cityName',
              'stateId', 'fcmTokens', 'notificationsEnabled', 'gameIds'];
    }

    // IDs de jogador do Master Duel / Duel Links: só os 9 dígitos.
    function isGameId(id) {
      return id is string && id.matches('^[0-9]{9}$');
    }

    function validGameIds(data) {
      return !('gameIds' in data) || (
        data.gameIds is map
        && data.gameIds.keys().hasOnly(['md', 'dl'])
        && (!('md' in data.gameIds) || isGameId(data.gameIds.md))
        && (!('dl' in data.gameIds) || isGameId(data.gameIds.dl))
      );
    }

    // Carteira inicial de cada categoria (TCG, Master Duel, Duel Links).
    function initialWallet() {
      return {'stars': 20, 'lockedStars': 0, 'wins': 0, 'losses': 0, 'streak': 0, 'bestStreak': 0};
    }

    match /users/{uid} {
      allow read: if signedIn();

      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(editableFields().concat([
             'wallets', 'disputeCount', 'createdAt']))
        && request.resource.data.wallets == {
             'tcg': initialWallet(), 'md': initialWallet(), 'dl': initialWallet()}
        && request.resource.data.disputeCount == 0
        && validGameIds(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.nickChangedAt == null
        && isNick(request.resource.data.nickLower)
        && request.resource.data.nick.lower() == request.resource.data.nickLower
        // O nick precisa ser reservado no MESMO batch (ver profile.service.ts).
        && getAfter(nickDoc(request.resource.data.nickLower)).data.uid == uid;

      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(editableFields())
        && validGameIds(request.resource.data)
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['nick', 'nickLower'])
          || (
            // Troca de nick: 1 a cada 30 dias (a primeira é livre).
            (resource.data.nickChangedAt == null
              || request.time > resource.data.nickChangedAt + duration.value(30, 'd'))
            && request.resource.data.nickChangedAt == request.time
            && isNick(request.resource.data.nickLower)
            && request.resource.data.nick.lower() == request.resource.data.nickLower
            && getAfter(nickDoc(request.resource.data.nickLower)).data.uid == uid
          )
        );
    }

    // Placar contra cada oponente - escrito só pelas Cloud Functions.
    match /users/{uid}/rivals/{otherUid} {
      allow read: if signedIn();
    }

    // Anotação privada de um duelo ("que deck foi usado?"): só o dono lê e
    // escreve, e só em duelo em que ele jogou.
    match /users/{uid}/duelNotes/{duelId} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['text', 'updatedAt'])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 280
        && request.resource.data.updatedAt == request.time
        && uid in get(/databases/$(database)/documents/duels/$(duelId)).data.players;
    }

    // Desafios (QR), duelos e feed são escritos só pelas Cloud Functions
    // (functions/src/duels.ts); o app apenas lê.
    match /challenges/{token} {
      allow read: if signedIn() && resource.data.creatorUid == request.auth.uid;
    }

    match /duels/{duelId} {
      allow read: if signedIn() && request.auth.uid in resource.data.players;
    }

    match /feed/{postId} {
      allow read: if signedIn();
    }

    // Um doc por nick (id = nick em minúsculas) garante que ele é único.
    // Ao trocar de nick, o antigo fica com `releasedAt` e continua reservado
    // por 30 dias, pra ninguém se passar pelo jogador logo depois da troca.
    match /nicks/{nick} {
      allow read: if signedIn();

      allow create: if signedIn() && isNick(nick)
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;

      allow update: if signedIn() && (
        // Dono libera o nick antigo ao trocar.
        (resource.data.uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['uid', 'releasedAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.releasedAt == request.time)
        // Qualquer um assume um nick liberado há mais de 30 dias, ou o dono
        // retoma o próprio nick liberado.
        || (resource.data.get('releasedAt', null) != null
          && (request.time > resource.data.releasedAt + duration.value(30, 'd')
              || resource.data.uid == request.auth.uid)
          && request.resource.data.keys().hasOnly(['uid'])
          && request.resource.data.uid == request.auth.uid)
      );
    }
  }
}
