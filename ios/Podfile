# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

# 16.0: os módulos Nitro (câmera/leitor de QR) usam a interoperabilidade
# Swift/C++, que exige iOS 16; também cobre o mínimo do ML Kit (15.5).
platform :ios, '16.0'
prepare_react_native_project!

# Firebase (React Native Firebase) no iOS exige frameworks estáticos - sem
# isso o pod install falha com "Swift pods cannot yet be integrated as
# static libraries" (AppCheckCore/GoogleUtilities). Com linkage estática, o
# Firebase via SPM duplica símbolos entre os pods do RNFirebase, então ele
# vem via CocoaPods ($RNFirebaseDisableSPM).
$RNFirebaseAsStaticFramework = true
$RNFirebaseDisableSPM = true
use_frameworks! :linkage => :static

target 'DuelStars' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
    # Pods que declaram um mínimo antigo herdam o do app - senão os Nitro
    # falham ao compilar ("module 'CxxStdlib' has a minimum deployment
    # target of iOS 16.0").
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        if config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'].to_f < 16.0
          config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '16.0'
        end
      end
    end
  end
end
